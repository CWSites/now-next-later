# Copy to .env.local (git-ignored) and fill in per machine.

# --- Data + sync ---
# Absolute path to the git repo that stores data/tasks.json.
# Defaults to the app's own repo root when unset.
DATA_REPO_PATH=

# Set to "0" to disable auto pull/push (useful for offline work).
GIT_SYNC_ENABLED=1

# Debounce window (ms) before committing after a change.
GIT_SYNC_DEBOUNCE_MS=2000

# --- Jira ingest ---
# e.g. https://your-org.atlassian.net
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=

# --- Slack ingest ---
# Browser session tokens (same pair used by slack-mcp-server).
# xoxc: from localStorage `localConfig_v2` → teams.<id>.token in Slack web app.
# xoxd: from the `d` cookie on slack.com.
# SLACK_MCP_XOXC_TOKEN=
# SLACK_MCP_XOXD_TOKEN=

# --- Google Calendar ingest (see issue #4) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# --- Lattice ingest (see issue #5) ---
# LATTICE_API_TOKEN=
