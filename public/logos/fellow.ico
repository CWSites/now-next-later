	<div class='electron-drag-header'></div>
	<div class='status-message'>
		<img alt='404' class="fellow-logo" src="https://cdn.fellow.app/static/images/logos/fellow-icon-outline.472e6d03b160.svg">
		<div class='status-message-container'>
			<h1>There's Nothing Here!</h1>
			<h2>
				Try heading back to the
				<a href="#" id="previous-page-link">previous page</a>.
			</h2>
			<h3>
				If you think something should be here, please
				<a href="mailto:help@fellow.co">contact us</a>.
			</h3>
		</div>
		<script nonce="9KAGzt40p+rClFbuAvFwqA==">
			document.getElementById('previous-page-link').addEventListener('click', function(e) {
				e.preventDefault();
				window.history.back();
			});
		</script>
	</div>


		
